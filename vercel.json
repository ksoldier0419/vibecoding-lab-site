{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "auth-dev/public/**",
          "auth-dev/private/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/instructor/(.*)",
      "dest": "/server.js",
      "headers": {"Cache-Control": "private, no-store"}
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/login.html",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/2026-2-java_basic/",
      "dest": "/2026-2-java_basic/index.html"
    },
    {
      "src": "/2026-2-python_adv/",
      "dest": "/2026-2-python_adv/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
